{
    "name": "mestiaque/sfl-inventory",
    "description": "Garments Inventory Management module for Laravel (Suhana Fashions Limited) by M. Estiaque Ahmed Khan",
    "type": "library",
    "keywords": [
        "Laravel",
        "SflInventory",
        "Inventory",
        "Estiaque"
    ],
    "authors": [
        {
            "name": "M. Estiaque Ahmed Khan",
            "email": "mrm.khan.1298@gmail.com",
            "homepage": "https://mestiaque.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "maatwebsite/excel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "ME\\SflInventory\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ME\\SflInventory\\SflInventoryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true
}